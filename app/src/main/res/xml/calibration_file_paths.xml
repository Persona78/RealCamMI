<?xml version="1.0" encoding="utf-8"?>
<!-- [REALCAMMI FORK 2026-09-12] Matches CameraCalibrationCapture's output_dir, which is
     getExternalFilesDir(null) + "/calibration/<timestamp>/" - and the zip cache file created
     just before sharing (see PreferenceSubCameraControlsMore's share button), which lives under
     getCacheDir() + "/calibration_share/". -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <external-files-path name="calibration" path="calibration/" />
    <cache-path name="calibration_share" path="calibration_share/" />
</paths>
